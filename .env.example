# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are local development credentials for containers that are not reachable from
# outside this machine; they are still generated, not chosen, and never reused anywhere.
#
# Both commands below run on the standard library alone, in the interpreter this project
# already has, on every platform it supports. They print and store nothing.
#
#   passwords, one run per password, never the same value twice:
#     .venv/Scripts/python.exe -c "import secrets; print(secrets.token_hex(24))"
#
#   AIRFLOW_FERNET_KEY: a Fernet key is 32 random bytes, urlsafe-base64-encoded, which
#   is what this produces without needing cryptography installed:
#     .venv/Scripts/python.exe -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# On macOS or Linux the interpreter path is .venv/bin/python.

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=platform

AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=
