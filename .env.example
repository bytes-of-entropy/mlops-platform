# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are local development credentials for containers that are not reachable from
# outside this machine; they are still generated, not chosen, and never reused anywhere.
#
#   openssl rand -hex 24                      -> passwords
#   .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                             -> AIRFLOW_FERNET_KEY

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=platform

AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
